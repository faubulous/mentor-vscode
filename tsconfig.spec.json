{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "./",
    "paths": {
      "@media/*": ["./media/*"],
      "@src/*": ["./src/*"],
      "$/*": ["./dist/*"]
    },
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": [
      "vitest/globals",
      "node"
    ]
  },
  "exclude": [
    "node_modules",
    "dist"
  ],
  "include": [
    "vitest.config.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts"
  ]
}
