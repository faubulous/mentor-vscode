PREFIX : <https://w3id.org/mentor-vscode/shapes/taxonomy#>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX shapes: <https://w3id.org/mentor-vscode/shapes/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

shapes:taxonomy a owl:Ontology ;
    owl:versionIRI <https://w3id.org/mentor-vscode/shapes/taxonomy/1.0.0> ;
    owl:versionInfo "1.0.0" ;
    dct:title "Mentor Taxonomy"@en ;
    dct:description "Concepts and concept schemes must have a preferred label, a definition and every concept must belong to a concept scheme."@en ;
    dct:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dct:creator <https://orcid.org/0000-0003-1876-1628> ;
    dct:publisher <https://orcid.org/0000-0003-1876-1628> ;
    dct:modified "2026-07-16"^^xsd:date .

:ConceptPrefLabelShape a sh:NodeShape ;
    rdfs:label "Concept Preferred Label Shape"@en ;
    rdfs:isDefinedBy shapes:taxonomy ;
    sh:targetClass skos:Concept ;
    sh:message "The concept must have at least one skos:prefLabel, at most one per language."@en ;
    sh:or (
        [ sh:nodeKind sh:BlankNode ]
        [ sh:property [ sh:path skos:prefLabel ; sh:minCount 1 ; sh:uniqueLang true ] ]
    ) .

:ConceptDefinitionShape a sh:NodeShape ;
    rdfs:label "Concept Definition Shape"@en ;
    rdfs:isDefinedBy shapes:taxonomy ;
    sh:targetClass skos:Concept ;
    sh:message "The concept must have at least one skos:definition."@en ;
    sh:or (
        [ sh:nodeKind sh:BlankNode ]
        [ sh:property [ sh:path skos:definition ; sh:minCount 1 ] ]
    ) .

:ConceptInSchemeShape a sh:NodeShape ;
    rdfs:label "Concept Scheme Membership Shape"@en ;
    rdfs:isDefinedBy shapes:taxonomy ;
    sh:targetClass skos:Concept ;
    sh:message "The concept must be part of a concept scheme via skos:inScheme or skos:topConceptOf."@en ;
    sh:or (
        [ sh:nodeKind sh:BlankNode ]
        [ sh:property [ sh:path [ sh:alternativePath ( skos:inScheme skos:topConceptOf ) ] ; sh:minCount 1 ] ]
    ) .

:ConceptSchemePrefLabelShape a sh:NodeShape ;
    rdfs:label "Concept Scheme Preferred Label Shape"@en ;
    rdfs:isDefinedBy shapes:taxonomy ;
    sh:targetClass skos:ConceptScheme ;
    sh:message "The concept scheme must have at least one skos:prefLabel, at most one per language."@en ;
    sh:or (
        [ sh:nodeKind sh:BlankNode ]
        [ sh:property [ sh:path skos:prefLabel ; sh:minCount 1 ; sh:uniqueLang true ] ]
    ) .

:ConceptSchemeDefinitionShape a sh:NodeShape ;
    rdfs:label "Concept Scheme Definition Shape"@en ;
    rdfs:isDefinedBy shapes:taxonomy ;
    sh:targetClass skos:ConceptScheme ;
    sh:message "The concept scheme must have at least one skos:definition."@en ;
    sh:or (
        [ sh:nodeKind sh:BlankNode ]
        [ sh:property [ sh:path skos:definition ; sh:minCount 1 ] ]
    ) .
