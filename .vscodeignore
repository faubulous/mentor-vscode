# Source and build tooling (extension ships pre-bundled dist/)
src/**
build.js
build-font.mjs
tsconfig.json
tsconfig.spec.json
vitest.config.ts

# Source maps: never loaded from a published extension, and they dominate its
# size -- the dist/ maps alone are ~48 MB against ~28 MB of bundles.
**/*.map

# Tests and coverage (out/ holds the compiled e2e suite)
coverage/**
e2e/**
out/**
**/*.test.ts
**/*.spec.ts

# Dev tooling / editor / CI config
.*
.github/**
.claude/**
.vscode/**
.vscode-test-web/**
node_modules/**
renovate.json

# Sibling workspace packages
../**

# Screenshots and other non-shipping media
**/media/screenshot*.png

# Packaged artifacts -- vsce writes the VSIX into dist/, so a stale one would
# otherwise be packed into the next build.
dist/*.vsix
